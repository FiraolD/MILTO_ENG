# Copy this file to .env and fill in real values (never commit .env).
# ---------------------------------------------------------------------------
# Backend (server/index.ts)
# ---------------------------------------------------------------------------

# Neon PostgreSQL pooled connection string (Neon dashboard > Connection Details)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret used to sign JWT auth tokens — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# JWT token lifetime (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Local API port (Express). Render sets PORT automatically.
PORT=3001

# Comma-separated allowed CORS origins.
# Locally: the Vite dev URLs. Production: your Vercel frontend domain.
CORS_ORIGIN=http://localhost:3030,http://localhost:3031

# Optional: folder for uploaded media files (defaults to server/uploads).
# On Render, point this at the mounted persistent disk.
# UPLOAD_DIR=/opt/uploads

# ---------------------------------------------------------------------------
# Frontend (optional)
# ---------------------------------------------------------------------------

# Not required — the app calls relative "/api" URLs, which are proxied by
# Vite in dev and by Vercel rewrites in production.
VITE_API_URL=
